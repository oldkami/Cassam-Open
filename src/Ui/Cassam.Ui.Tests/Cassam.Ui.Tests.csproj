<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Platform-neutral UI test project. Only references
      Cassam.Ui.Hardware.Common (Mocks, DTOs, Stubs, HAL
      interfaces) so it can be restored + tested on any CI
      runner without pulling in platform-specific workload
      dependencies (Android workload, Windows EnableWindows
      Targeting, wasm-tools).

      Per-platform HAL contract tests live in their own test
      projects so they only restore + build on the matching
      CI runner:
        * src/Ui/Cassam.Ui.Hardware.Windows.Tests (net10.0-windows10.0.19041.0)
        * src/Ui/Cassam.Ui.Hardware.Linux.Tests   (net10.0)

      Cross-platform integration tests with REAL HAL implementations
      are out of CI scope (manual QA per platform per design §10 R-UI-10).

      PR 9.6 motivation: previously this csproj had conditional
      ProjectReferences to Cassam.Ui.Hardware.Windows and
      Cassam.Ui.Hardware.Linux (and was multi-targeted
      net10.0;net10.0-windows10.0.19041.0). Restoring the project
      transitively pulled those HAL projects on every CI runner,
      which surfaced Android / Windows EnableWindowsTargeting
      errors on Linux / macOS. PR 9.5 worked around the symptom by
      dropping the test steps from the per-platform jobs; PR 9.6
      is the structural fix — Mock-based tests live here, real
      HAL tests live next to their HAL project.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FluentAssertions" Version="6.12.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cassam.Ui.Hardware.Common\Cassam.Ui.Hardware.Common.csproj" />
  </ItemGroup>

</Project>