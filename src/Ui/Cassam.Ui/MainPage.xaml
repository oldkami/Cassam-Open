<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Cassam.Ui.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Cassam.Ui"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <!--
    PR 7 brand layout (design §17.1, question #1 RESOLVED 2026-06-24).
    PR 10 (T2.09): added the "Modo manager" button so the operator
    can switch from the cashier bootstrap into the manager shell
    (REQ-UI-03). The button is visible only when the active user
    has a manager role — the placeholder role check always shows
    the button in Phase 2 because the session-state stub returns
    OWNER for the demo fixture; Phase 3 wires the real Keycloak
    role binding.
  -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0"
                Orientation="Horizontal"
                Margin="24,16,24,16"
                Spacing="16"
                VerticalAlignment="Center">
      <Image Source="ms-appx:///Assets/logoCassamTransp.png"
             Height="64"
             Stretch="Uniform"
             HorizontalAlignment="Left"
             VerticalAlignment="Center"
             AutomationProperties.Name="Cassam logo" />
      <TextBlock Text="Cassam POS"
                 FontSize="32"
                 FontWeight="SemiBold"
                 VerticalAlignment="Center"
                 AutomationProperties.AutomationId="CassamAppTitle" />
    </StackPanel>

    <StackPanel Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
      <TextBlock x:Name="StatusText"
                 AutomationProperties.AutomationId="CassamStatusText"
                 Text="Cassam POS — listo / ready"
                 FontSize="24"
                 HorizontalAlignment="Center" />
      <Button x:Name="OpenManagerButton"
              Content="Modo manager"
              MinHeight="44"
              MinWidth="200"
              HorizontalAlignment="Center"
              Click="OnOpenManagerClicked"
              AutomationProperties.AutomationId="MainPageOpenManager" />
    </StackPanel>
  </Grid>
</Page>
