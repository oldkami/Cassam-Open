<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Cassam.Ui.Manager.ManagerOverviewView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
      AutomationProperties.Name="Resumen del manager">
  <!--
    Manager overview (landing sub-view). Plain welcome card so
    the shell has something to render on first launch + after
    every navigation back. PR 10 ships the simplest possible
    welcome — the rich dashboard tiles (today's sales, DIAN
    quick-glance, alerts) are out of scope and land with the
    Reports work in PR 11.
  -->
  <Grid Padding="32">
    <StackPanel Spacing="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
      <TextBlock Text="Bienvenido al modo manager"
                 FontSize="28"
                 FontWeight="SemiBold"
                 HorizontalAlignment="Center"
                 AutomationProperties.AutomationId="ManagerOverviewHeading" />
      <TextBlock Text="Use el panel de la izquierda para navegar a Productos, Clientes, Caja, Reportes, DIAN o Administración."
                 FontSize="14"
                 Opacity="0.7"
                 TextWrapping="Wrap"
                 MaxWidth="480"
                 HorizontalAlignment="Center"
                 TextAlignment="Center" />
    </StackPanel>
  </Grid>
</Page>