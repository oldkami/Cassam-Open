<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Cassam.Ui.Manager.CustomerManagementView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Cassam.Ui.Hardware.Common.Manager"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
      AutomationProperties.Name="Clientes">
  <!--
    Customer management sub-view (PR 10, T2.09.b, REQ-UI-03).
    Mirror of <see cref="ProductManagementView"/> for the
    customer entity. ListView + search bar + edit overlay.
  -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Padding="24,16,24,8" ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="Clientes"
                 FontSize="24"
                 FontWeight="SemiBold"
                 VerticalAlignment="Center"
                 AutomationProperties.AutomationId="CustomersTitle" />
      <Button Grid.Column="1"
              Content="Agregar"
              MinHeight="44"
              Command="{x:Bind ViewModel.BeginAddCommand}"
              AutomationProperties.AutomationId="CustomersAddButton" />
    </Grid>

    <Grid Grid.Row="1" Padding="24,4,24,8">
      <TextBox PlaceholderText="Buscar por nombre o número de documento"
               Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               MinHeight="44"
               AutomationProperties.AutomationId="CustomersSearchBox" />
    </Grid>

    <Border Grid.Row="2"
            BorderBrush="{ThemeResource SystemAccentColor}"
            BorderThickness="1"
            CornerRadius="4"
            Margin="24,8,24,8">
      <ListView x:Name="CustomersList"
                ItemsSource="{x:Bind ViewModel.Customers, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedCustomer, Mode=TwoWay}"
                SelectionMode="Single"
                AutomationProperties.Name="Lista de clientes">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="local:CustomerListItem">
            <Grid Padding="8,8,8,8" ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0"
                         Text="{x:Bind DocumentNumber}"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                         Text="{x:Bind Name}"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2"
                         Text="{x:Bind Email}"
                         Opacity="0.7"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="3"
                      Content="Editar"
                      MinHeight="44"
                      MinWidth="44"
                      Command="{Binding DataContext.BeginEditCommand, ElementName=CustomersList}"
                      CommandParameter="{x:Bind}"
                      AutomationProperties.AutomationId="CustomersEditRow" />
              <Button Grid.Column="4"
                      Content="Eliminar"
                      MinHeight="44"
                      MinWidth="44"
                      Command="{Binding DataContext.DeleteCommand, ElementName=CustomersList}"
                      CommandParameter="{x:Bind}"
                      AutomationProperties.AutomationId="CustomersDeleteRow" />
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Border>

    <TextBlock Grid.Row="3"
               Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
               Padding="24,8,24,16"
               Opacity="0.7"
               AutomationProperties.AutomationId="CustomersStatusMessage" />

    <Grid Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay}"
          Grid.Row="0"
          Grid.RowSpan="4"
          Background="#80000000">
      <Border Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
              BorderBrush="{ThemeResource SystemAccentColor}"
              BorderThickness="2"
              CornerRadius="8"
              Padding="24"
              MaxWidth="480"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock Text="Editar cliente"
                     FontSize="20"
                     FontWeight="SemiBold" />
          <TextBox Header="Número de documento"
                   Text="{x:Bind ViewModel.EditingCustomer.DocumentNumber, Mode=TwoWay, FallbackValue=''}"
                   MinHeight="44" />
          <TextBox Header="Nombre / Razón social"
                   Text="{x:Bind ViewModel.EditingCustomer.Name, Mode=TwoWay, FallbackValue=''}"
                   MinHeight="44" />
          <TextBox Header="Email"
                   Text="{x:Bind ViewModel.EditingCustomer.Email, Mode=TwoWay, FallbackValue=''}"
                   MinHeight="44" />
          <TextBox Header="Teléfono"
                   Text="{x:Bind ViewModel.EditingCustomer.Phone, Mode=TwoWay, FallbackValue=''}"
                   MinHeight="44" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Cancelar"
                    MinHeight="44"
                    Command="{x:Bind ViewModel.CancelEditCommand}"
                    AutomationProperties.AutomationId="CustomersCancelEdit" />
            <Button Content="Guardar"
                    MinHeight="44"
                    Background="Green"
                    Foreground="White"
                    Command="{x:Bind ViewModel.SaveCommand}"
                    AutomationProperties.AutomationId="CustomersSaveEdit" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Page>