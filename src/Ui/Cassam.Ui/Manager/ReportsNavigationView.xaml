<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Cassam.Ui.Manager.ReportsNavigationView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
      AutomationProperties.Name="Reportes">
  <!--
    Reports navigation shell (PR 10, T2.09.d). Renders the three
    report sub-tabs (DailySales / Inventory / CashClose) and the
    "[Reporte se renderiza en PR 11]" placeholder. PR 11 ships
    the actual renderer (DataGrid + QuestPdfReportRenderer per
    design §11).

    The active tab is bound to the VM's <c>SelectedTab</c>; the
    placeholder text below is a single static line that hints the
    user that real content is coming.
  -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Padding="24,16,24,8" ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="Reportes"
                 FontSize="24"
                 FontWeight="SemiBold"
                 VerticalAlignment="Center"
                 AutomationProperties.AutomationId="ReportsTitle" />
      <Button Grid.Column="1"
              Content="Ventas del día"
              MinHeight="44"
              Click="OnDailySalesClicked"
              AutomationProperties.AutomationId="ReportsDailySalesTab" />
      <Button Grid.Column="2"
              Content="Inventario"
              MinHeight="44"
              Click="OnInventoryClicked"
              AutomationProperties.AutomationId="ReportsInventoryTab" />
      <Button Grid.Column="3"
              Content="Cierre de caja"
              MinHeight="44"
              Click="OnCashCloseClicked"
              AutomationProperties.AutomationId="ReportsCashCloseTab" />
    </Grid>

    <Border Grid.Row="1"
            Margin="24,8,24,24"
            Padding="32"
            BorderBrush="{ThemeResource SystemAccentColor}"
            BorderThickness="1"
            CornerRadius="4">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="12">
        <TextBlock x:Name="ActiveReportTitle"
                   Text="Ventas del día"
                   FontSize="20"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   AutomationProperties.AutomationId="ReportsActiveTabTitle" />
        <TextBlock Text="[Reporte se renderiza en PR 11]"
                   FontSize="14"
                   Opacity="0.6"
                   HorizontalAlignment="Center"
                   AutomationProperties.AutomationId="ReportsPlaceholderText" />
      </StackPanel>
    </Border>
  </Grid>
</Page>