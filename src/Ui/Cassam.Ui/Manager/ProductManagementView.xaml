<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Cassam.Ui.Manager.ProductManagementView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Cassam.Ui.Hardware.Common.Manager"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
      AutomationProperties.Name="Productos">
  <!--
    Product management sub-view (PR 10, T2.09.a, REQ-UI-03,
    SCN-UI-03). Renders a list of products + a search bar + add
    / edit / delete buttons. The edit dialog is a Border overlay
    bound to the VM's <c>IsEditing</c> + <c>EditingProduct</c>
    state so the VM owns the modal's lifecycle.

    Touch targets ≥44 dp per SCN-UI-11 — every button declares
    MinHeight=44.
  -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header. -->
    <Grid Grid.Row="0" Padding="24,16,24,8" ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="Productos"
                 FontSize="24"
                 FontWeight="SemiBold"
                 VerticalAlignment="Center"
                 AutomationProperties.AutomationId="ProductsTitle" />
      <Button Grid.Column="1"
              Content="Agregar"
              MinHeight="44"
              Command="{x:Bind ViewModel.BeginAddCommand}"
              AutomationProperties.AutomationId="ProductsAddButton" />
    </Grid>

    <!-- Search bar. -->
    <Grid Grid.Row="1" Padding="24,4,24,8">
      <TextBox x:Name="SearchBox"
               PlaceholderText="Buscar por SKU, nombre o código de barras"
               Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               MinHeight="44"
               AutomationProperties.AutomationId="ProductsSearchBox" />
    </Grid>

    <!-- Product list. -->
    <Border Grid.Row="2"
            BorderBrush="{ThemeResource SystemAccentColor}"
            BorderThickness="1"
            CornerRadius="4"
            Margin="24,8,24,8">
      <ListView x:Name="ProductsList"
                ItemsSource="{x:Bind ViewModel.Products, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedProduct, Mode=TwoWay}"
                SelectionMode="Single"
                AutomationProperties.Name="Lista de productos">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="local:ProductListItem">
            <Grid Padding="8,8,8,8" ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0"
                         Text="{x:Bind Sku}"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                         Text="{x:Bind Name}"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2"
                         Text="{x:Bind Barcode}"
                         Opacity="0.7"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="3"
                         Text="{x:Bind UnitPrice, Converter={StaticResource CurrencyConverter}}"
                         VerticalAlignment="Center"
                         TextAlignment="Right" />
              <TextBlock Grid.Column="4"
                         Text="{x:Bind StockQuantity}"
                         VerticalAlignment="Center"
                         TextAlignment="Right" />
              <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8">
                <Button Content="Editar"
                        MinHeight="44"
                        MinWidth="44"
                        Command="{Binding DataContext.BeginEditCommand, ElementName=ProductsList}"
                        CommandParameter="{x:Bind}"
                        AutomationProperties.AutomationId="ProductsEditRow" />
                <Button Content="Eliminar"
                        MinHeight="44"
                        MinWidth="44"
                        Command="{Binding DataContext.DeleteCommand, ElementName=ProductsList}"
                        CommandParameter="{x:Bind}"
                        AutomationProperties.AutomationId="ProductsDeleteRow" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Border>

    <!-- Status footer. -->
    <TextBlock Grid.Row="3"
               Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
               Padding="24,8,24,16"
               Opacity="0.7"
               AutomationProperties.AutomationId="ProductsStatusMessage" />

    <!-- Edit overlay. Hidden when IsEditing is false. -->
    <Grid x:Name="EditOverlay"
          Grid.Row="0"
          Grid.RowSpan="4"
          Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay}"
          Background="#80000000">
      <Border Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
              BorderBrush="{ThemeResource SystemAccentColor}"
              BorderThickness="2"
              CornerRadius="8"
              Padding="24"
              MaxWidth="480"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock Text="Editar producto"
                     FontSize="20"
                     FontWeight="SemiBold" />
          <TextBox Header="SKU"
                   Text="{x:Bind ViewModel.EditingProduct.Sku, Mode=TwoWay, FallbackValue=''}"
                   MinHeight="44" />
          <TextBox Header="Nombre"
                   Text="{x:Bind ViewModel.EditingProduct.Name, Mode=TwoWay, FallbackValue=''}"
                   MinHeight="44" />
          <TextBox Header="Código de barras"
                   Text="{x:Bind ViewModel.EditingProduct.Barcode, Mode=TwoWay, FallbackValue=''}"
                   MinHeight="44" />
          <TextBox Header="Precio unitario (COP)"
                   InputScope="Number"
                   Text="{x:Bind ViewModel.EditingProduct.UnitPrice, Mode=TwoWay, Converter={StaticResource DecimalConverter}, FallbackValue=0}"
                   MinHeight="44" />
          <TextBox Header="Existencia"
                   InputScope="Number"
                   Text="{x:Bind ViewModel.EditingProduct.StockQuantity, Mode=TwoWay, Converter={StaticResource DecimalConverter}, FallbackValue=0}"
                   MinHeight="44" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Cancelar"
                    MinHeight="44"
                    Command="{x:Bind ViewModel.CancelEditCommand}"
                    AutomationProperties.AutomationId="ProductsCancelEdit" />
            <Button Content="Guardar"
                    MinHeight="44"
                    Background="Green"
                    Foreground="White"
                    Command="{x:Bind ViewModel.SaveCommand}"
                    AutomationProperties.AutomationId="ProductsSaveEdit" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Page>