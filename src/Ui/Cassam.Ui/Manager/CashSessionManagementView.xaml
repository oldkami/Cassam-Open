<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Cassam.Ui.Manager.CashSessionManagementView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Cassam.Ui.Hardware.Common.Manager"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
      AutomationProperties.Name="Caja registradora">
  <!--
    Cash session management sub-view (PR 10, T2.09.c, REQ-CORE-10).
    Top card shows the open session (if any) + the open/close
    buttons. Bottom section lists the most recent 20 closed
    sessions.

    Open + close dialogs are overlays bound to the VM's
    <c>IsOpening</c> / <c>IsClosing</c> properties. The variance
    surfaces in the status footer when the close confirms.
  -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Open-session card. -->
    <Border Grid.Row="0"
            Margin="24,16,24,8"
            Padding="16"
            BorderBrush="{ThemeResource SystemAccentColor}"
            BorderThickness="1"
            CornerRadius="4">
      <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Spacing="6">
          <TextBlock Text="Estado de caja"
                     FontSize="18"
                     FontWeight="SemiBold"
                     AutomationProperties.AutomationId="CashSessionStatusHeading" />
          <TextBlock FontSize="14"
                     AutomationProperties.AutomationId="CashSessionStatusText">
            <Run Text="Sesión abierta por " />
            <Run Text="{x:Bind ViewModel.OpenSession.OpenedByUserName, Mode=OneWay, FallbackValue=''}" />
            <Run Text=" — Monto apertura: " />
            <Run Text="{x:Bind ViewModel.OpenSession.OpeningAmount, Mode=OneWay, Converter={StaticResource CurrencyConverter}, FallbackValue=''}" />
          </TextBlock>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="Abrir caja"
                  MinHeight="44"
                  IsEnabled="{x:Bind ViewModel.OpenSession, Mode=OneWay, Converter={StaticResource NullToBoolConverter}}"
                  Command="{x:Bind ViewModel.BeginOpenCommand}"
                  AutomationProperties.AutomationId="CashSessionOpenButton" />
          <Button Content="Cerrar caja"
                  MinHeight="44"
                  IsEnabled="{x:Bind ViewModel.OpenSession, Mode=OneWay, Converter={StaticResource NullToBoolConverter}}"
                  Command="{x:Bind ViewModel.BeginCloseCommand}"
                  AutomationProperties.AutomationId="CashSessionCloseButton" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Status footer. -->
    <TextBlock Grid.Row="1"
               Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
               Padding="24,4,24,8"
               Opacity="0.7"
               AutomationProperties.AutomationId="CashSessionStatusMessage" />

    <!-- Recent history list. -->
    <Border Grid.Row="2"
            Margin="24,8,24,16"
            Padding="0"
            BorderBrush="{ThemeResource SystemAccentColor}"
            BorderThickness="1"
            CornerRadius="4">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                   Text="Historial reciente"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Padding="16,12,16,4"
                   AutomationProperties.AutomationId="CashSessionHistoryHeading" />
        <ListView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.RecentSessions, Mode=OneWay}"
                  AutomationProperties.Name="Historial de sesiones de caja">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="local:CashSessionSummary">
              <Grid Padding="12,8,12,8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="160" />
                  <ColumnDefinition Width="160" />
                  <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{x:Bind OpenedAt, Converter={StaticResource DateEsCoConverter}}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{x:Bind OpenedByUserName}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Text="{x:Bind OpeningAmount, Converter={StaticResource CurrencyConverter}}"
                           VerticalAlignment="Center"
                           TextAlignment="Right" />
                <TextBlock Grid.Column="3"
                           Text="{x:Bind ClosingAmount, Converter={StaticResource CurrencyConverter}, FallbackValue=''}"
                           VerticalAlignment="Center"
                           TextAlignment="Right" />
                <TextBlock Grid.Column="4"
                           Text="{x:Bind VarianceAmount, Converter={StaticResource CurrencyConverter}, FallbackValue=''}"
                           VerticalAlignment="Center"
                           TextAlignment="Right" />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Grid>
    </Border>

    <!-- Open dialog overlay. -->
    <Grid Visibility="{x:Bind ViewModel.IsOpening, Mode=OneWay}"
          Grid.Row="0"
          Grid.RowSpan="3"
          Background="#80000000">
      <Border Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
              BorderBrush="{ThemeResource SystemAccentColor}"
              BorderThickness="2"
              CornerRadius="8"
              Padding="24"
              MaxWidth="420"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock Text="Abrir caja"
                     FontSize="20"
                     FontWeight="SemiBold" />
          <TextBox Header="Monto de apertura (COP)"
                   InputScope="Number"
                   Text="{x:Bind ViewModel.OpeningAmountInput, Mode=TwoWay, Converter={StaticResource DecimalConverter}}"
                   MinHeight="44" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Cancelar"
                    MinHeight="44"
                    Command="{x:Bind ViewModel.CancelOpenCommand}" />
            <Button Content="Confirmar"
                    MinHeight="44"
                    Background="Green"
                    Foreground="White"
                    Command="{x:Bind ViewModel.ConfirmOpenCommand}"
                    AutomationProperties.AutomationId="CashSessionConfirmOpen" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Close dialog overlay. -->
    <Grid Visibility="{x:Bind ViewModel.IsClosing, Mode=OneWay}"
          Grid.Row="0"
          Grid.RowSpan="3"
          Background="#80000000">
      <Border Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
              BorderBrush="{ThemeResource SystemAccentColor}"
              BorderThickness="2"
              CornerRadius="8"
              Padding="24"
              MaxWidth="420"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock Text="Cerrar caja"
                     FontSize="20"
                     FontWeight="SemiBold" />
          <TextBox Header="Monto de cierre contado (COP)"
                   InputScope="Number"
                   Text="{x:Bind ViewModel.ClosingAmountInput, Mode=TwoWay, Converter={StaticResource DecimalConverter}}"
                   MinHeight="44" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Cancelar"
                    MinHeight="44"
                    Command="{x:Bind ViewModel.CancelCloseCommand}" />
            <Button Content="Confirmar"
                    MinHeight="44"
                    Background="Green"
                    Foreground="White"
                    Command="{x:Bind ViewModel.ConfirmCloseCommand}"
                    AutomationProperties.AutomationId="CashSessionConfirmClose" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Page>